rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección "tasks". Debe coincidir con src/types/Task.ts.
    // Todo lo que no esté listado aquí queda denegado.
    match /tasks/{taskId} {

      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // dueDate es opcional: si existe debe ser un string YYYY-MM-DD.
      function hasValidDueDate(data) {
        return !('dueDate' in data)
               || (data.dueDate is string
                   && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      // Campos exactos del modelo Task (sin id: es el id del documento).
      // dueDate es el único campo opcional.
      function hasValidShape(data) {
        return data.keys().hasOnly([
                 'title', 'description', 'completed',
                 'userId', 'createdAt', 'updatedAt', 'dueDate'
               ])
               && data.keys().hasAll([
                 'title', 'description', 'completed',
                 'userId', 'createdAt', 'updatedAt'
               ])
               && data.title is string
               && data.title.size() > 0
               && data.title.size() <= 100
               && data.description is string
               && data.description.size() <= 1000
               && data.completed is bool
               && data.userId is string
               && data.createdAt is timestamp
               && data.updatedAt is timestamp
               && hasValidDueDate(data);
      }

      allow read, delete: if isOwner(resource.data.userId);

      allow create: if isOwner(request.resource.data.userId)
                    && hasValidShape(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(resource.data.userId)
                    && hasValidShape(request.resource.data)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
    }
  }
}
