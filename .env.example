# Configuración de Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend (Vercel Functions, /api). Sin prefijo VITE_: nunca llegan al navegador.
# Configurarlas en Vercel > Settings > Environment Variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clave privada de la cuenta de servicio; los saltos de línea pueden ir como \n.
FIREBASE_PRIVATE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Remitente verificado en AWS SES.
SES_FROM_EMAIL=
